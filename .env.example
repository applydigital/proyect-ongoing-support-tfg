# Copiar este archivo a .env y completar los valores. NUNCA subir el .env real al repo.

# Entorno objetivo de sanity/regression: staging (por defecto) o production.
# En production no se usa Basic Auth y los tests de checkout paran antes de pagar.
TARGET_ENV=staging

# ── Basic Auth del sandbox SFCC (solo staging/dev, compartido por todas las marcas) ──
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=

# ── URLs de staging ──
HOBBS_BASE_URL=
PHASE_EIGHT_BASE_URL=
INSIDE_STORY_BASE_URL=
WHISTLES_BASE_URL=
SANDBOX_URL=

# ── URLs de producción (solo con TARGET_ENV=production) ──
HOBBS_PROD_URL=
PHASE_EIGHT_PROD_URL=
INSIDE_STORY_PROD_URL=
WHISTLES_PROD_URL=

# ── Otras suites del repo (opcional, solo si se ejecutan) ──
# Gift cards: GIFT_CARD_NUMBER, GIFT_CARD_PIN, INACTIVE_GIFT_CARD_NUMBER, INACTIVE_GIFT_CARD_PIN,
#             CC_NUMBER, CC_EXPIRY_MONTH, CC_EXPIRY_YEAR, CC_CVV
# Business Manager / WebDAV: BM_URL, BM_USERNAME, BM_PASSWORD, WEBDAV_URL
# PayPal refund: PAYPAL_BUYER_EMAIL, PAYPAL_BUYER_PASSWORD
# Log Center: LOG_CENTER_URL, LOG_CENTER_USERNAME, LOG_CENTER_PASSWORD
